# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,cjs}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{html,css}]
indent_style = space
indent_size = 4

[{package.json,pnpm-lock.yaml,pnpm-workspace.yaml,tsconfig.json,tsconfig.base.json,tsconfig.node.json}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf