{
    "name": "slicer-converter-monorepo",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Slicer converter monorepo",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build": "pnpm run build:app",
        "build:app": "pnpm --filter @slicer-converter/slicer-app build",
        "build:cli:artifacts": "powershell -ExecutionPolicy Bypass -File scripts/build-cli-artifacts.ps1",
        "build:wasm": "pnpm --filter @slicer-converter/wasm build",
        "dev": "pnpm --filter @slicer-converter/slicer-app dev",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck",
        "check:fix": "pnpm format && pnpm lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "pnpm typecheck && pnpm test:rust && pnpm test:wasm:unit && pnpm test:app && pnpm test:scripts",
        "test:app": "pnpm --filter @slicer-converter/slicer-app test:unit",
        "test:app:coverage": "pnpm --filter @slicer-converter/slicer-app test:unit:coverage",
        "test:app:e2e": "pnpm --filter @slicer-converter/slicer-app test:e2e",
        "test:app:roundtrip": "pnpm --filter @slicer-converter/slicer-app test:e2e:roundtrip",
        "test:app:roundtrip:real": "pnpm --filter @slicer-converter/slicer-app test:e2e:roundtrip:real",
        "test:app:roundtrip:real:headed": "pnpm --filter @slicer-converter/slicer-app test:e2e:roundtrip:real:headed",
        "test:browser": "pnpm test:wasm:browser && pnpm test:app:e2e",
        "test:full": "pnpm test && pnpm test:browser",
        "test:rust": "cargo test --manifest-path rust/Cargo.toml --workspace",
        "test:wasm": "wasm-pack test --node rust/crates/wasm",
        "test:wasm:browser": "node scripts/run-wasm-browser-test.mjs --test wasm_api_browser",
        "test:wasm:unit": "pnpm --filter @slicer-converter/wasm test:unit",
        "test:scripts": "node --test scripts/*.test.mjs",
        "benchmark:app": "pnpm --filter @slicer-converter/slicer-app bench",
        "benchmark:wasm:browser": "node scripts/run-wasm-browser-test.mjs --release --test wasm_simd_bench",
        "benchmark:ci": "node scripts/check-benchmark-threshold.mjs",
        "benchmark:rust": "cargo bench --manifest-path rust/Cargo.toml -p slicer-converter-core -- --output-format bencher",
        "preview": "pnpm --filter @slicer-converter/slicer-app preview",
        "fixtures": "cargo run --manifest-path rust/Cargo.toml -p slicer-converter-core --example generate_fixtures",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "eslint": "^10.2.0",
        "prettier": "^3.8.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1"
    }
}
