{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["node"],
        "noEmit": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@/*": ["apps/slicer-app/src/*"],
            "@innovgame/slicer-converter": ["packages/slicer-wasm/src/index.ts"]
        }
    },
    "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx"],
    "exclude": ["**/dist/**", "**/node_modules/**", "packages/slicer-wasm/lib/**", "rust/target/**", "rust/data/**"]
}
